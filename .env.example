# Copy to .env (never committed).

OPENROUTER_API_KEY=sk-or-v1-...

MODEL_SMART=anthropic/claude-sonnet-4.5
MODEL_CHEAP=anthropic/claude-haiku-4.5
# The judge must be a stronger model than the one it judges.
MODEL_JUDGE=anthropic/claude-sonnet-4.5
# A different vendor on purpose: an outage usually takes a provider with it.
MODEL_FALLBACK=google/gemini-2.5-flash

# Braintrust (optional) — versioned trajectory-eval scores
# BRAINTRUST_API_KEY=
# BRAINTRUST_API_URL=https://api.braintrust.dev
# BRAINTRUST_PROJECT_ID=

DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5433/agentdesk

# The agent's tools are the two other services.
TRIAGELY_URL=http://localhost:8000/v1
TRIAGELY_API_KEY=tg_dev
DOCPILOT_URL=http://localhost:8001/v1
DOCPILOT_API_KEY=dp_dev
DOCPILOT_COLLECTION=fastapi

# Shared key for the MCP server's remote transport. Empty means stdio only, which is the safe
# default: a local server reachable by one client needs no key, a remote one does.
MCP_API_KEY=

# Budgets, checked before every iteration. Spend is USD (what the provider reports);
# refund amounts are EUR and capped in the tool schema, not here.
MAX_ITERATIONS=10
MAX_TOKENS_TOTAL=50000
MAX_COST_USD=0.50
MAX_WALL_SECONDS=120
